# --- same variables config.py already reads ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=bugtracker

# --- frontend integration ---
TRACKER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- optional features ---
GROQ_API_KEY=            # needed for the "AI Analyze" button
HF_API_KEY=              # better category/severity (keyword fallback if empty)
EMAIL_USER=              # Gmail address, for "Send mail to tester"
EMAIL_PASS=              # Gmail app password
